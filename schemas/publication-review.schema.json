{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://massivemagnetics.example/schemas/publication-review.schema.json",
  "title": "MASSIVEMAGNETICS-IP Publication Review",
  "type": "object",
  "required": ["review_id", "invention_id", "target", "reviewer", "decision", "checks"],
  "properties": {
    "review_id": {"type": "string", "minLength": 2},
    "invention_id": {"type": "string", "pattern": "^MMIP-[0-9]{4}-[0-9]{4,}$"},
    "target": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "decision": {"enum": ["publish", "hold", "file_first", "trade_secret", "abandon"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_disclosure_complete", "evidence_integrity_verified", "attribution_complete", "prior_art_review_complete", "patent_strategy_decided", "trade_secret_exposure_assessed", "trade_secrets_removed", "repository_sanitized"],
      "properties": {
        "internal_disclosure_complete": {"type": "boolean"},
        "evidence_integrity_verified": {"type": "boolean"},
        "attribution_complete": {"type": "boolean"},
        "prior_art_review_complete": {"type": "boolean"},
        "patent_strategy_decided": {"type": "boolean"},
        "trade_secret_exposure_assessed": {"type": "boolean"},
        "trade_secrets_removed": {"type": "boolean"},
        "repository_sanitized": {"type": "boolean"}
      }
    }
  }
}
